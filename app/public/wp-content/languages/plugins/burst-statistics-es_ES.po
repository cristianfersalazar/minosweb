#: includes/Frontend/Tracking/class-high-traffic-buffer.php:713
msgid "Buffer incoming hits to disk and ingest them in scheduled background batches to reduce database load during pageviews."
msgstr "Guarda en disco las visitas entrantes y las procesa en lotes programados en segundo plano para reducir la carga de la base de datos durante las vistas de página."

#. translators: %s: relative time elapsed since the last background buffer run.
#: includes/Frontend/Tracking/class-high-traffic-buffer.php:708
msgid "Last buffer ingestion run: %s ago."
msgstr "Último procesamiento del búfer: hace %s."

#. translators: %s: relative time elapsed since the last background buffer run.
#: includes/Frontend/Tracking/class-high-traffic-buffer.php:700
msgid "Warning: The background buffer processor has not run in over 10 minutes (last run %s ago). Buffered hits are currently falling back to direct database writes."
msgstr "Advertencia: El procesador del búfer en segundo plano no se ha ejecutado desde hace más de 10 minutos (última ejecución hace %s). Como alternativa, las visitas del búfer se están escribiendo directamente en la base de datos."

#: includes/Frontend/Tracking/class-high-traffic-buffer.php:692
msgid "High-traffic buffer mode requires the WordPress root directory to be writable to generate the buffer configuration file."
msgstr "El modo búfer para mucho tráfico necesita que el directorio raíz de WordPress tenga permisos de escritura para generar el archivo de configuración del búfer."

#: includes/Frontend/Tracking/class-high-traffic-buffer.php:685
msgid "High-traffic buffer mode is not supported on WordPress multisite installations."
msgstr "El modo búfer para mucho tráfico no es compatible con instalaciones multisitio de WordPress."

