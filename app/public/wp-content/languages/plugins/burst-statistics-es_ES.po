msgstr "Resumen general del escritorio con las estadísticas clave, las métricas de visitantes y el rendimiento reciente de un vistazo."

#: includes/Admin/App/config/fields.php:174
msgid "Load a minimal tracking script without scroll depth, goals and CO₂ measurement. Smallest possible footprint."
msgstr "Carga un script de seguimiento mínimo sin profundidad de desplazamiento, objetivos ni medición de CO₂. El menor impacto posible."

#: includes/Admin/App/config/fields.php:173
msgid "Essentials mode"
msgstr "Modo Esencial"

