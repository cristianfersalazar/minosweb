msgid "Downloaded package file not found."
msgstr "No se ha encontrado el archivo del paquete descargado."

#. translators: 1: manifest version, 2: installed version
#: includes/Admin/Update_Verification/class-package-verifier.php:341
msgid "Manifest version %1$s is not newer than installed version %2$s."
msgstr "La versión del manifiesto %1$s no es más reciente que la versión instalada %2$s."

#. translators: 1: manifest version, 2: expected version
#: includes/Admin/Update_Verification/class-package-verifier.php:329
msgid "Manifest version %1$s does not match expected version %2$s."
msgstr "La versión del manifiesto %1$s no coincide con la versión esperada %2$s."

