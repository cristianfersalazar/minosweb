msgid "Manifest version is missing."
msgstr "Falta la versión del manifiesto."

#: includes/Admin/Update_Verification/class-package-verifier.php:312
msgid "Manifest channel is not supported."
msgstr "El canal del manifiesto no es compatible."

#: includes/Admin/Update_Verification/class-package-verifier.php:306
msgid "Beta channel package not allowed on this site."
msgstr "No se permiten paquetes del canal beta en este sitio."

#: includes/Admin/Update_Verification/class-package-verifier.php:297
msgid "Manifest product does not match Burst Pro."
msgstr "El producto del manifiesto no coincide con Burst Pro."

#: includes/Admin/Update_Verification/class-package-verifier.php:290
msgid "Unsupported manifest format version."
msgstr "La versión del formato del manifiesto no es compatible."

#: includes/Admin/Update_Verification/class-package-verifier.php:267
#: includes/Admin/Update_Verification/class-package-verifier.php:282
msgid "Package signature verification failed."
msgstr "Ha fallado la verificación de la firma del paquete."

#: includes/Admin/Update_Verification/class-package-verifier.php:260
msgid "Public key is invalid."
msgstr "La clave pública no es válida."

#: includes/Admin/Update_Verification/class-package-verifier.php:249
msgid "Unknown signing key ID."
msgstr "ID de clave de firma desconocido."

#: includes/Admin/Update_Verification/class-package-verifier.php:240
msgid "Decoded manifest is not valid JSON."
msgstr "El manifiesto decodificado no es un JSON válido."

#: includes/Admin/Update_Verification/class-package-verifier.php:226
msgid "Manifest or signature could not be base64-decoded."
msgstr "No se ha podido decodificar en base64 el manifiesto o la firma."

#: includes/Admin/Update_Verification/class-package-verifier.php:214
msgid "Signature data is missing manifest or signature envelope."
msgstr "A los datos de la firma les falta el manifiesto o el sobre de la firma."

#: includes/Admin/Update_Verification/class-package-verifier.php:195
msgid "Could not fetch signature manifest from any server."
msgstr "No se ha podido obtener el manifiesto de firma de ningún servidor."

#: includes/Admin/Update_Verification/class-package-verifier.php:185
msgid "Signature manifest response was not valid JSON."
msgstr "La respuesta del manifiesto de firma no era un JSON válido."

#. translators: %d: HTTP response code
#: includes/Admin/Update_Verification/class-package-verifier.php:167
msgid "Could not fetch signature manifest (HTTP %d)."
msgstr "No se ha podido obtener el manifiesto de firma (HTTP %d)."

#: includes/Admin/Tour/class-tour.php:1145
msgid "The sources and entry pages behind this goal, sorted by conversions."
msgstr "Las fuentes y páginas de entrada detrás de este objetivo, ordenadas por conversiones."

#: includes/Admin/Tour/class-tour.php:1144
msgid "Where conversions come from 🧭"
msgstr "De dónde vienen las conversiones 🧭"

#: includes/Admin/Tour/class-tour.php:1135
msgid "The title says what happened to conversions. Below it: conversions, converting visitors and conversion rate, and the trend against the previous period. The filter icon next to the name shows this goal on Insights."
msgstr "El título te dice qué ha pasado con las conversiones. Debajo verás las conversiones, los visitantes que convierten y la tasa de conversión, además de la tendencia respecto al periodo anterior. El icono de filtro junto al nombre muestra este objetivo en Perspectivas."

#: includes/Admin/Tour/class-tour.php:1134
msgid "One goal, one conclusion 💡"
msgstr "Un objetivo, una conclusión 💡"

#: includes/Admin/Tour/class-tour.php:1124
msgid "Click a goal to see its own results."
msgstr "Haz clic en un objetivo para ver sus propios resultados."

#: includes/Admin/Tour/class-tour.php:1123
msgid "Open a goal 🔍"
msgstr "Abre un objetivo 🔍"

#: includes/Admin/Tour/class-tour.php:1114
msgid "All goals adds up every active goal. Goals compared shows which goal brings the most conversions, at what rate, and how that changed."
msgstr "Todos los objetivos suma todos los objetivos activos. Objetivos comparados muestra qué objetivo genera más conversiones, con qué tasa y cómo ha cambiado."

#: includes/Admin/Tour/class-tour.php:1113
msgid "Which goal brings conversions 📊"
msgstr "Qué objetivo genera conversiones 📊"

#: includes/Admin/Tour/class-tour.php:1104
msgid "Every goal shows what it tracks, its conversions and the change against the previous period. A goal that stopped counting gets an amber warning."
msgstr "Cada objetivo muestra lo que mide, sus conversiones y el cambio respecto al periodo anterior. Un objetivo que ha dejado de contar recibe una advertencia en ámbar."

#: includes/Admin/Import/Adapters/File/class-ga4-csv-adapter.php:153
msgid "This export looks incomplete: Google Analytics cut it off, so the imported numbers will be too low. For complete data, export shorter periods and import them one by one."
msgstr "Parece que esta exportación está incompleta: Google Analytics la ha cortado, así que los números importados serán demasiado bajos. Para tener datos completos, exporta periodos más cortos e impórtalos uno a uno."

#. translators: %s: comma-separated list of column names.
#: includes/Admin/Import/Adapters/File/class-ga4-csv-adapter.php:127
msgid "We could not find these columns: %s. Add them to your Google Analytics export. If Google Analytics is not in English, switch it to English first. Then upload the new file."
msgstr "No hemos encontrado estas columnas: %s. Añádelas a tu exportación de Google Analytics. Si Google Analytics no está en inglés, cámbialo primero a inglés. Después, sube el nuevo archivo."

#: includes/Admin/Import/Adapters/File/class-csv-file-adapter.php:87
msgid "This file does not have the columns we expect from this source."
msgstr "Este archivo no tiene las columnas que esperamos de esta fuente."

